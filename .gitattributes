# Normalise line endings in the repository; check out with the platform default.
* text=auto eol=lf

*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
LICENSE text eol=lf

# Binary-ish files that must never be line-ending converted.
*.png  binary
*.jpg  binary
*.ico  binary
